{
  "name": "obiex-api",
  "version": "1.0.0",
  "description": "Obiex Node.js API client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepare": "husky install",
    "format": "eslint ./src/**/*.ts --fix && npx prettier src --write"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run format"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obiexhq/obiex-api-javascript.git"
  },
  "keywords": [
    "auth",
    "obiex"
  ],
  "author": "Obiex HQ",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/obiexhq/obiex-api-javascript/issues"
  },
  "homepage": "https://github.com/obiexhq/obiex-api-javascript#readme",
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^5.47.0",
    "@typescript-eslint/parser": "^5.47.0",
    "eslint": "^8.30.0",
    "husky": "^8.0.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.2.2",
    "form-data": "^4.0.6",
    "node-cache": "^5.1.2"
  }
}
